
# @CAP_AUTOCONF_NOTICE@

# Build libcap's source files via kbuild so they're ABI-compatible with
# the kernel they'll be linked into.
#
# Historical note: this Kbuild used to declare `lib-y += $(COMMON_SRCS:.c=.o)`
# and kbuild produced lib.a (which an automake step renamed to libcap.a).
# Modern kbuild (>= ~v6.x) only honors lib-y for in-tree builds; for
# external (M=...) builds nothing gets compiled. Instead, declare a
# module so kbuild actually walks the source list and emits each .o
# in place. Downstream consumers either pick up the individual .o
# files directly, or assemble them into libcap.a via `ar` (see
# Makefile.am: all-lib-cp). The libcap.ko produced by kbuild itself is
# an unused side product.

# Note: Kernel expects the files to be relative paths (it always prepends
# the current directory).

# This single line of magic makes it so we can do an out of src tree
# build. It has to do with how and where this Kbuild file is included
# in the kernel build system.
src = @abs_top_srcdir@/src

# This needs to be inside here because the kernel build system forces gcc
# otherwise.
export CC=@CC@

# Declare libcap.o as a module so kbuild compiles the constituent
# objects in external (M=) builds.
obj-m += libcap.o
libcap-y += $(COMMON_SRCS:.c=.o)

# Pass along include directories from the Automake file
ccflags-y += $(CFLAGS) $(AM_CPPFLAGS)
# Explicit include paths so the kernel kbuild sub-make can find libcap_internal.h
# even when AM_CPPFLAGS is not propagated through the kernel make environment.
ccflags-y += -I@abs_top_srcdir@/src/include \
             -I@abs_top_builddir@/src/include \
             -I@abs_top_srcdir@/src/platform/kernel/include \
             -I@abs_top_builddir@

# Provide option to filter out some kbuild cflags (this is needed for
# clang builds).
KBUILD_CFLAGS := $(filter-out $(LIBCAP_BAD_CFLAGS), $(KBUILD_CFLAGS))